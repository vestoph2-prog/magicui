# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# Публичный HTTPS-адрес, где доступен этот сервер (Mini App URL)
WEBAPP_URL=https://crm.example.com
# Короткое имя Mini App из @BotFather (/newapp) — для ссылок вида t.me/bot/app (необязательно)
APP_SHORT_NAME=
# Telegram ID администраторов через запятую. Если пусто — админом станет первый вошедший.
ADMIN_IDS=
PORT=3000
# 127.0.0.1 — если сервер стоит за nginx на этой же машине
HOST=0.0.0.0
DB_PATH=data/crm.db
# Только для локальной разработки: вход без Telegram (?dev=1:Имя)
DEV_AUTH=0
# Утренняя сводка: час (0–23) по часовому поясу ниже; пусто — выключить
DIGEST_HOUR=8
TZ_NAME=Europe/Moscow
