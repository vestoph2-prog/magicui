{
  "name": "crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:api": "DEV_AUTH=1 node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "test": "node --test --disable-warning=ExperimentalWarning test/*.test.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "ultracite": "5.4.4",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
