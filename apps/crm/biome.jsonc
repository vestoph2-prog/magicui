{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "files": {
    "includes": ["**", "!data", "!dist"]
  },
  "linter": {
    "rules": {
      "style": {
        // Telegram Bot API and our DB enums are snake_case by contract.
        "useNamingConvention": "off",
        "noMagicNumbers": "off"
      }
    }
  }
}
